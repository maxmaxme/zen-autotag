{
  "name": "zen-autotag",
  "version": "0.1.0",
  "private": true,
  "description": "Categorises new ZenMoney transactions with an AI classifier (payee habits, receipts from Gmail) and asks in Telegram only when unsure — self-hosted",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run knip && npm run typecheck && npm test",
    "prepare": "lefthook install",
    "knip": "knip"
  },
  "dependencies": {
    "imapflow": "^2.2.4",
    "mailparser": "^3.9.34",
    "node-html-parser": "^9.0.4",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
