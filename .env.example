# Copy to .env and fill in. Auto-loaded by `node src/index.ts` when running
# outside Docker. In Docker, pass these via env_file: / environment: instead.

# ─── ZenMoney (required) ──────────────────────────────────────────────
# ZenMoney has no self-service API keys; sign in at https://zerro.app and
# copy localStorage.zm_token. ZENMONEY_SERVER is localStorage.zm_server
# there: "ru" (api.zenmoney.ru) or "app" (api.zenmoney.app).
ZENMONEY_TOKEN=
ZENMONEY_SERVER=ru

# ─── Gmail (required) ─────────────────────────────────────────────────
# IMAP with an app password: Google account → Security → 2-Step
# Verification on → https://myaccount.google.com/apppasswords. Spaces in
# the 16-character password are optional.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── TypeSafe Jev (optional) ──────────────────────────────────────────
# Picks one of your candidate categories (chosen in the UI, each with your
# hint) from the order's line items. Without it, only per-store categories
# set in the UI apply; everything else waits in review.
TYPESAFE_TOKEN=
# Picks below this confidence wait in review instead of applying.
JEV_MIN_CONFIDENCE=0.6

# ─── Matching ─────────────────────────────────────────────────────────
# ZenMoney payees a receipt may match (case-insensitive regex).
ZM_PAYEE_PATTERN=glovo
# How far back the very first run reads mail.
MAIL_LOOKBACK_DAYS=90
RUN_INTERVAL_MINUTES=10
# How long a receipt waits for its charge to appear in ZenMoney — longer
# than the longest gap between your bank syncs there.
RECEIPT_EXPIRE_DAYS=45

# ─── Telegram (optional) ──────────────────────────────────────────────
# One message when runs start failing, one when they recover.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Runtime ──────────────────────────────────────────────────────────
# SQLite lives here. Defaults to /app/data; locally e.g. ./data.
ZEN_RECEIPTS_DATA_DIR=
PORT=8080
LOG_LEVEL=info
