# Copy to .env next to package.json for local runs. In Docker, pass these via
# env_file: / environment: instead.

# ─── ZenMoney (required) ──────────────────────────────────────────────
# ZenMoney has no self-service API keys; sign in at https://zerro.app and copy
# localStorage.zm_token. ZENMONEY_SERVER is localStorage.zm_server there.
ZENMONEY_TOKEN=
ZENMONEY_SERVER=ru

# ─── TypeSafe Jev (required) ──────────────────────────────────────────
TYPESAFE_TOKEN=

# ─── Telegram (required) ──────────────────────────────────────────────
# A bot of its own (@BotFather): this service long-polls it for button taps,
# and a bot can have only one poller. Send it /start once.
ZEN_TELEGRAM_BOT_TOKEN=
# Your chat id; taps from any other chat are ignored.
TELEGRAM_CHAT_ID=

# ─── Gmail (optional) ─────────────────────────────────────────────────
# For receipts (Glovo, Amazon). IMAP with an app password: Google account →
# 2-Step Verification on → https://myaccount.google.com/apppasswords.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Tuning (optional) ────────────────────────────────────────────────
# At or above: applied silently. Below: applied, and you're asked in Telegram.
MIN_CONFIDENCE=0.8
# Below this Jev's pick isn't applied at all; the category stays and you're asked.
APPLY_CONFIDENCE=0.5
SCAN_MINUTES=5
# SQLite with the start date and category hints; created on first start.
DB_PATH=./data/zen-autotag.sqlite
# A config.json from before the database is imported once, then renamed.
CONFIG_PATH=./data/config.json
# 1 = decide and message, but write nothing to ZenMoney.
DRY_RUN=
